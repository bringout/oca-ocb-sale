#, []
msgid ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    No activities found. Let's start a new one!\n"
"                </p><p>\n"
"                    Track your working hours by projects every day and invoice this time to your customers.\n"
"                </p>\n"
"            "
msgstr ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    Nema pronađenih aktivnosti. Hajde da započnemo novu!\n"
"                </p><p>\n"
"                    Pratite svoje radne sate po projektima svaki dan i fakturisajte ovo vrijeme svojim kupcima.\n"
"                </p>\n"
"            "

# model: code:addons/sale_timesheet/models/account_move.py
#, []
msgid ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    Record timesheets\n"
"                </p><p>\n"
"                    You can register and track your workings hours by project every\n"
"                    day. Every time spent on a project will become a cost and can be re-invoiced to\n"
"                    customers if required.\n"
"                </p>\n"
"            "
msgstr ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    Registriraj evidencije radnog vremena\n"
"                </p><p>\n"
"                    Možete registrirati i pratiti svoje radne sate po projektu svaki\n"
"                    dan. Svaki sati utrošen na projektu postaje trošak i može se refakturisati\n"
"                    kupcima ako je potrebno.\n"
"                </p>"

